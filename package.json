{
  "name": "seed-design-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI-first Vite + React starter locked in to the SEED Design System, structured with Feature-Sliced Design.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "tsx scripts/bootstrap.ts",
    "dev": "vite --config config/vite.config.ts",
    "build": "pnpm routes:gen && tsc -b && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "routes:gen": "tsr generate",
    "typecheck": "pnpm routes:gen && tsc -b --noEmit",
    "lint": "eslint -c config/eslint.config.js .",
    "lint:fix": "eslint -c config/eslint.config.js . --fix",
    "lint:fsd": "steiger ./src",
    "format": "prettier --config config/prettier.config.js --write .",
    "format:check": "prettier --config config/prettier.config.js --check .",
    "seed:sync": "tsx scripts/sync-seed.ts",
    "seed:check": "tsx scripts/sync-seed.ts --check",
    "seed:compat": "seed-design compat",
    "seed:add": "seed-design add",
    "seed:docs": "seed-design docs",
    "brand:sync": "tsx scripts/sync-brand.ts",
    "brand:check": "tsx scripts/sync-brand.ts --check",
    "verify:lockin": "tsx scripts/verify-lockin.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm lint:fsd && pnpm format:check && pnpm seed:check && pnpm brand:check && pnpm seed:compat && pnpm verify:lockin && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@seed-design/css": "^2.3.0",
    "@seed-design/react": "^2.1.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.20",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@seed-design/cli": "^1.6.1",
    "@seed-design/tailwind4-theme": "^2.3.0",
    "@seed-design/vite-plugin": "^2.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-cli": "^1.167.23",
    "@tanstack/router-plugin": "^1.168.25",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "steiger": "^0.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint -c config/eslint.config.js --fix",
      "prettier --config config/prettier.config.js --write"
    ],
    "*.{json,md,mdc,css,html,yml,yaml}": [
      "prettier --config config/prettier.config.js --write"
    ]
  }
}
