# Copy to env/.env.local (gitignored) for machine-specific values.
# Only VITE_* keys are exposed to client code via import.meta.env.

# Public API base URL used by the app (optional until a backend is wired).
VITE_API_BASE_URL=

# App display name shown in the document title / bootstrap copy (optional).
VITE_APP_NAME=seed-design-starter
